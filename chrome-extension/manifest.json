{
  "manifest_version": 3,
  "name": "酷鸟云 VPS 增强助手",
  "version": "1.0.0",
  "description": "将酷鸟云 VPS 增强助手的管理面板迁移到 Chrome 扩展，并接管远程进入与标签页操作。",
  "action": {
    "default_title": "VPS 增强助手",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://home.kuniaovps.com/*",
    "*://home.geliyun.com/*",
    "*://ntba.gte666.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://home.kuniaovps.com/*",
        "*://home.geliyun.com/*",
        "*://ntba.gte666.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
